WRITE_ASCII 0x2cc ~c0sraid7~  #8  // dialogue
WRITE_ASCII 0x280 ~c0sraid7~ #32 // death variable

COPY_EXISTING ~democler.cre~ ~override/c0sraid8.cre~
WRITE_ASCII 0x248 ~c0sraid8~  #8  // override
WRITE_ASCII 0x2cc ~c0sraid8~  #8  // dialogue
WRITE_ASCII 0x280 ~c0sraid8~ #32 // death variable
REMOVE_CRE_ITEM ~minhp1~

COPY_EXISTING ~sargrd04.cre~ ~override/c0sraid9.cre~
