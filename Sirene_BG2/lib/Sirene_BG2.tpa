COPY_EXISTING ~sargrd05.cre~ ~override/c0sraid6.cre~
WRITE_ASCII 0x248 ~c0sraid6~  #8  // override
WRITE_ASCII 0x2cc ~c0sraid6~  #8  // dialogue
WRITE_ASCII 0x280 ~c0sraid6~ #32 // death variable

COPY_EXISTING ~sargrd05.cre~ ~override/c0sraid7.cre~
