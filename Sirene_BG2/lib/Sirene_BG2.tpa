WRITE_ASCII 0x280 ~c0sraid9~ #32 // death variable

COPY_EXISTING ~hspectr1.cre~ ~override/C0SirenG.cre~
WRITE_ASCII 0x248 ~C0SirenG~  #8  // override
WRITE_ASCII 0x2cc ~C0SirenG~  #8  // dialogue
WRITE_ASCII 0x280 ~C0SirenG~ #32 // death variable
SAY NAME1 ~塞琳~
SAY NAME2 ~塞琳~
WRITE_ASCII 0x34  ~SireneG~ #8
SAY INITIAL_MEETING ~~
SAY SELECT_COMMON1 ~~

COPY_EXISTING ~uddeath.cre~ ~override/c0deathk.cre~
