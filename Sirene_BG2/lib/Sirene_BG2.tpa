// Fate Spirit Summoning
ACTION_IF GAME_IS ~eet~ BEGIN
  INCLUDE ~EET/other/EET_functions.tph~
  ACTION_IF FILE_EXISTS_IN_GAME ~c0sirene.cre~ BEGIN
    OUTER_SET type_var = 3 //this will change already applied type of transition = 1 to 3
  END ELSE BEGIN
    OUTER_SET type_var = 2 //BG1 version of NPC is not installed, so just add BG2 only transition
  END
  LAF ~EET_NPC_TRANSITION~
    INT_VAR
      type = type_var
    STR_VAR
      dv = "C0Sirene"
      override_BG1 = "C0SIRENE" //won't be used if type_var = 2
      override_SoD = "C02SIREN" //won't be used if type_var = 2
      override_SoA = "C0SIRE2"
      override_ToB = "C0SIRE25"
      dialog_ToB = "C0SIRE25"
      //traFile = "%MOD_FOLDER%/tra/%LANGUAGE%/sirene.tra"
      //string = "@1"
      string = "把塞琳带来给我，那个提夫林殉道者。"
      stringPosDV = "Skie"
  END
END ELSE BEGIN
  COMPILE ~%MOD_FOLDER%/dialogue/FATESP.d~
END